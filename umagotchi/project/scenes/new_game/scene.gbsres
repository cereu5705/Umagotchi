    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Welcome to Tracen\nAcademy, Trainer!",
          "My name is Tazuna,\nand I'm here to\nassign an",
          "Umamusume trainee\nto you.",
          "Train her well,\nso that she can\nreach her goals!",
          "Would you like a \nbrief tutorial\nbefore starting?"
        ],
        "__section": "text",
        "avatarId": "",
        "minHeight": 4,
